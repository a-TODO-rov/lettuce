<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      io.lettuce:lettuce - the reactor-free distribution of Lettuce.

      This module compiles NO source of its own. During generate-sources it copies the
      main Lettuce source, runs the lettuce-build-tools ReactorFreeTransformer to remove
      all reactive code, and compiles the result with reactor-core absent. The full
      io.lettuce:lettuce-core (built by the root module) is unaffected; this is a second,
      reactor-free artifact derived from the same source.

      The <dependencies> block below is DERIVED from lettuce-core's flattened POM by
      ReactorFreePomDeps (build-tools): lettuce-core's resolved dependency set minus
      everything that pulls Project Reactor, Kotlin coroutines, or the RxJava reactive
      bridges. Do not hand-edit between the reactor-free:deps markers; regenerate instead.
    -->

    <groupId>io.lettuce</groupId>
    <artifactId>lettuce</artifactId>
    <version>8.0-REACTOR-OPTIONAL-PRE</version>
    <packaging>jar</packaging>

    <name>Lettuce (reactor-free)</name>
    <description>Advanced and thread-safe Java Redis client for synchronous and asynchronous usage,
        built from the same source as lettuce-core with all Project Reactor code removed.</description>
    <url>https://github.com/redis/lettuce</url>
    <organization>
        <name>lettuce.io</name>
    </organization>
    <licenses>
        <license>
            <name>MIT</name>
            <url>https://github.com/redis/lettuce/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer><id>tishun</id><name>Tihomir Mateev</name></developer>
        <developer><id>mp911de</id><name>Mark Paluch</name></developer>
        <developer><id>will</id><name>Will Glozer</name></developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/redis/lettuce.git</connection>
        <developerConnection>scm:git:https://github.com/redis/lettuce.git</developerConnection>
        <url>https://github.com/redis/lettuce</url>
    </scm>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <maven.test.skip>true</maven.test.skip>
        <skipTests>true</skipTests>
        <rf.sources>${project.build.directory}/generated-sources/reactor-free</rf.sources>
    </properties>

    <distributionManagement>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com/api/v1/publisher/deployments/upload/</url>
        </repository>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <dependencies>
        <!-- reactor-free:deps:begin (generated by ReactorFreePomDeps; do not edit) -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>13.0</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>redis.clients.authentication</groupId>
            <artifactId>redis-authx-core</artifactId>
            <version>0.1.1-beta2</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-common</artifactId>
            <version>4.2.13.Final</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
            <version>4.2.13.Final</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
            <version>4.2.13.Final</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
            <version>2.12.0</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-tcnative</artifactId>
            <version>2.0.65.Final</version>
            <classifier>${os.detected.classifier}</classifier>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-resolver-dns</artifactId>
            <version>4.2.13.Final</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
            <version>4.2.13.Final</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-epoll</artifactId>
            <version>4.2.13.Final</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-kqueue</artifactId>
            <version>4.2.13.Final</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-io_uring</artifactId>
            <version>4.2.13.Final</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.zipkin.brave</groupId>
            <artifactId>brave</artifactId>
            <version>5.13.11</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.latencyutils</groupId>
            <artifactId>LatencyUtils</artifactId>
            <version>2.0.3</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <version>1.14.2</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
            <version>1.14.2</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
            <version>1.2.4</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
            <version>2.2.2</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>javax.enterprise</groupId>
            <artifactId>cdi-api</artifactId>
            <version>2.0.SP1</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>3.0.2</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <!-- reactor-free:deps:end -->
    </dependencies>

    <build>
        <extensions>
            <!-- Resolves ${os.detected.classifier} for the platform-specific netty-tcnative dependency. -->
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <!-- 1. copy the main source tree into our generated-sources dir -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-main-source</id>
                        <phase>generate-sources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${rf.sources}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../src/main/java</directory>
                                    <includes><include>**/*.java</include></includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 2. strip all reactive code from the copy -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- 0. fail early if the derived dependency block drifted from lettuce-core's flattened POM -->
                    <execution>
                        <id>reactor-free-deps-check</id>
                        <phase>validate</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-cp</argument>
                                <argument>${project.basedir}/../lettuce-build-tools/target/lettuce-build-tools-${project.version}.jar</argument>
                                <argument>io.lettuce.build.ReactorFreePomDeps</argument>
                                <argument>--check</argument>
                                <argument>${project.basedir}/../.flattened-pom.xml</argument>
                                <argument>${project.basedir}/pom.xml</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>reactor-free-strip</id>
                        <phase>generate-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <!-- AST transformer (JavaParser) from lettuce-build-tools; built earlier in the reactor. -->
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.basedir}/../lettuce-build-tools/target/lettuce-build-tools-${project.version}.jar</argument>
                                <argument>${rf.sources}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 3. compile the stripped source -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-reactor-free-source</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${rf.sources}</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 4. jar with the same automatic module name -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries>
                            <Automatic-Module-Name>lettuce.core</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!-- 5. publish a clean, self-contained POM -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                        <configuration>
                            <updatePomFile>true</updatePomFile>
                            <flattenMode>oss</flattenMode>
                            <pomElements><properties>remove</properties></pomElements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 6. sources jar (from the stripped generated source) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 7. javadoc jar (house policy: doclint none, quiet); the strip already scrubbed dangling links -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <level>public</level>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <failOnError>false</failOnError>
                </configuration>
            </plugin>
            <!-- 8. publish through the Central Portal, same as lettuce-core -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.8.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <waitUntil>published</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Compatibility guard: assert the reactor-free API (io.lettuce:lettuce, "new") is a clean SUBSET of
          io.lettuce:lettuce-core ("old") - i.e. the strip only removed reactive surface and changed nothing else.
          Revapi fails the build on any breaking difference EXCEPT the intended reactive removals, which are ignored
          by the two explicit signals we already use: the reactive packages, and reactor/reactive-streams types in a
          signature (the removed @ReactorIncompatible members). Run: mvn -Prevapi -pl lettuce-reactor-free verify
          (requires io.lettuce:lettuce-core and io.lettuce:lettuce installed in the local repository).
        -->
        <profile>
            <id>revapi</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.revapi</groupId>
                        <artifactId>revapi-maven-plugin</artifactId>
                        <version>0.15.1</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.revapi</groupId>
                                <artifactId>revapi-java</artifactId>
                                <version>0.28.4</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- old = the full distribution; new = this module's artifact (io.lettuce:lettuce). -->
                            <oldArtifacts>
                                <artifact>io.lettuce:lettuce-core:${project.version}</artifact>
                            </oldArtifacts>
                            <newArtifacts>
                                <artifact>io.lettuce:lettuce:${project.version}</artifact>
                            </newArtifacts>
                            <checkDependencies>false</checkDependencies>
                            <failSeverity>breaking</failSeverity>
                            <analysisConfiguration><![CDATA[
{
  "revapi": {
    "java": {
      "missing-classes": { "behavior": "ignore" }
    },
    "differences": {
      "ignore": true,
      "differences": [
        { "regex": true, "code": ".*", "old": ".*io\\.lettuce\\.core\\..*[Rr]eactive.*",
          "justification": "reactive package/type - intentionally stripped" },
        { "regex": true, "code": ".*", "new": ".*io\\.lettuce\\.core\\..*[Rr]eactive.*",
          "justification": "reactive package/type - intentionally stripped" },
        { "regex": true, "code": ".*", "old": ".*reactor\\.core\\.publisher\\..*",
          "justification": "member exposing a Reactor type - intentionally stripped" },
        { "regex": true, "code": ".*", "old": ".*org\\.reactivestreams\\..*",
          "justification": "member exposing a Reactive Streams type - intentionally stripped" },
        { "regex": true, "code": ".*", "old": ".*io\\.lettuce\\.core\\.(ScanStream|RedisPublisher|Operators|RedisCredentialsProvider|AsyncCredentialsProviderAdapter).*",
          "justification": "reclassified reactive helper - intentionally stripped" },
        { "regex": true, "code": "java\\.class\\.removed", "old": ".*Coroutines.*",
          "justification": "Kotlin coroutines API - reactor-free carries no Kotlin (coroutines are reactive)" },
        { "regex": true, "code": "java\\.class\\.removed", "old": ".*ExtensionsKt.*",
          "justification": "Kotlin extension class - reactor-free carries no Kotlin" },
        { "regex": true, "code": "java\\.class\\.removed", "old": ".*io\\.lettuce\\.core\\.ScanFlow.*",
          "justification": "Kotlin Flow-based scan - reactor-free carries no Kotlin" },
        { "regex": true, "code": "java\\.method\\.varargOverloadsOnlyDifferInVarargParameter",
          "justification": "pre-existing lettuce-core API-design lint, not introduced by the strip" },
        { "regex": true, "code": "java\\.class\\.nonPublicPartOfAPI",
          "justification": "pre-existing lettuce-core API-hygiene lint, not introduced by the strip" }
      ]
    }
  }
}
                            ]]></analysisConfiguration>
                        </configuration>
                        <executions>
                            <execution>
                                <id>reactor-free-api-subset</id>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
